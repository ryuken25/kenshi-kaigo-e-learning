node_modules
dist
.vercel
.DS_Store

# Env files
.env
.env.*
.env*

# Secrets — creds.txt holds GitHub PAT, Vercel token, Neon API key,
# Cloudflare/R2, Midtrans and Porkbun keys. Never commit.
creds.txt
creds*.txt
*.creds
secrets.txt

# Local agent/tool config (contains API tokens)
# SELURUH .claude/ diabaikan, bukan cuma settings — agent bisa menulis file lain di situ.
.claude/

# Skill/prompt library lokal — bukan bagian dari produk
skills/

# Local file backups
# Catatan: .backup/ pernah IKUT TER-COMMIT (8 file) walau baris ini sudah ada, karena
# .gitignore tidak berlaku surut untuk file yang terlanjur di-track. Sudah di-untrack
# dengan `git rm -r --cached .backup`. Kalau muncul lagi di `git status`, itu sebabnya.
.backup/

# DB dumps produced by scripts/backup-db.mjs
*.dump.json
backup-*.json

# Smoke-test scratch dir (payload, token, header temp — jangan pernah ke-commit)
.smoke/

# Kanvas desain: sumbernya (kit/screens/build + chars/) di-commit, hasil generate tidak.
# .dc.html dan halaman ter-seed dibangun ulang dengan `node docs/design/canvas/build.mjs`.
docs/design/canvas/*.dc.html
docs/design/canvas/canvas.json
docs/design/canvas/kenshi-kaigo-semua-layar.html
docs/design/canvas/_verify.png

# Referensi desain lokal (halaman Duolingo yang disimpan lengkap dengan asetnya).
# Bahan banding tata letak saja — bukan bagian produk, dan isinya aset pihak ketiga
# yang tidak boleh ikut ke repo.
contoh/
